---
import Hero from '@/components/Hero.astro';
import Layout from '../layouts/Layout.astro';
import Carte3d from '@/components/Carte3d.astro';
import Services from '@/components/Services.astro';
import { AuroraBackground } from "@/components/ui/aurorabackground";
import Faq from '@/components/faq.astro';
import Avis from '@/components/avis.astro';
import Contact from '@/components/contact.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<AuroraBackground client:load>
		<Hero />
	</AuroraBackground>
	<section class="section-layout flex sm:flex-col bg-neutral-100 gap-16">
		<div class=" w-1/3 flex flex-col gap-4">
			<h2 class="">
		Omnaris en quelques chiffres c'est
			</h2>
			<p>Chaque projet est pensé pour faire de votre site internet un actif durable qui accompagnera votre croissance dans le temps.</p>
		</div>
		<div class="w-2/3 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

				<!-- Card 1 -->
				<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm hover:shadow-md transition-shadow">
				  <div class="flex items-center gap-3 mb-4">
					<div class="text-xl">🤝</div>
					<span class="text-xl font-bold text-gray-900">+20</span>
				  </div>
				  <div class="border-t border-dashed border-gray-300 pt-6">
					<p class="text-sm leading-relaxed text-gray-700">
					  Entreprises accompagnées sur leur présence en ligne et leur croissance.
					</p>
				  </div>
				</div>
			  
				<!-- Card 2 -->
				<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm hover:shadow-md transition-shadow">
				  <div class="flex items-center gap-3 mb-4">
					<div class="text-xl">📈</div>
					<span class="text-xl font-bold text-gray-900">6 mois</span>
				  </div>
				  <div class="border-t border-dashed border-gray-300 pt-6">
					<p class="text-sm leading-relaxed text-gray-700">
					  Durée moyenne nécessaire à nos clients pour rentabiliser leur site internet.
					</p>
				  </div>
				</div>
			  
				<!-- Card 3 -->
				<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm hover:shadow-md transition-shadow">
				  <div class="flex items-center gap-3 mb-4">
					<div class="text-xl">💼</div>
					<span class="text-xl font-bold text-gray-900">+4</span>
				  </div>
				  <div class="border-t border-dashed border-gray-300 pt-6">
					<p class="text-sm leading-relaxed text-gray-700">
					  Ans d'expérience en création de site internet et acquisition digitale.
					</p>
				  </div>
				</div>

		</div>
		
	</section>
	<Services />
	<section id="realisations" class="overflow-hidden section-layout flex flex-col justify-center items-start gap-8 bg-neutral-100">
		<span class="inline-flex rounded-full bg-secondary/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-secondary">
			Réalisations
		  </span>
		<h2 class="">Nos dernières réalisations</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			<Carte3d titre='Site vitrine Onis' urlImage='/image-onis.png' urlLive='https://be-onis.com'/>
			<Carte3d titre='Site vitrine TFN' urlImage='/tfn.png' urlLive='https://transport-funeraire-normandie.webflow.io/'/>
			<Carte3d titre='Landing page Le courtier du carrelage' urlImage='/courtier.png' urlLive='https://www.lecourtierducarrelage.com'/>
		</div>
	</section>
	<Avis />
	<Contact />
	<Faq />
	

	
</Layout>
