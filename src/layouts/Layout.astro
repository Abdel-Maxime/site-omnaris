---
import Navbar2 from '@/components/Navbar2.astro'

import Footer from '@/components/Footer.astro'
import '../styles/global.css'
import Navigation from '@/components/Navigation.astro'

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex=false } = Astro.props;
---
<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/icone.png" />
		<link rel="icon" href="/icone.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		 <!-- Google Fonts - Urbanist -->
		 <link rel="preconnect" href="https://fonts.googleapis.com">
		 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		 <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex, nofollow"/>}
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<Navigation />
		<slot />
		<Footer />
		<script>
			import { initSplitTextAnimation } from "../scripts/heading-animation.js";
			
			// Init on page load
			document.addEventListener("DOMContentLoaded", initSplitTextAnimation);
			
			// Handle Astro view transitions
			document.addEventListener("astro:page-load", initSplitTextAnimation);
			// Removed cleanupSplitTextAnimation as it is not exported
		  </script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
