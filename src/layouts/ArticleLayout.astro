---
import Layout from './Layout.astro';
const { frontmatter, headings = [] } = Astro.props;
---
<Layout title={frontmatter.title} description={frontmatter.description}>
    <main class="section-layout mt-5 flex flex-row flex-wrap">
        <div class="breadcrumbs py-4 w-full text-sm">
            <ul>
              <li><a href="/">Accueil</a></li>
              <li><a href="/blog">Blog</a></li>
              <li>{frontmatter.title}</li>
            </ul>
        </div>
        
        <aside class="hidden w-1/4 sticky top-10 self-start flex-col gap-8 sm:hidden md:flex lg:flex">
            <!-- Sidebar content -->
             <div class="flex flex-col gap-4">
                <h2 class="text-lg ">Auteur de l'article</h2>
                <div class="flex flex-row">
                    <div class="w-12 h-12 rounded-full bg-gray-300 flex items-center justify-center text-xl font-bold text-white">
                        {frontmatter.author ? frontmatter.author.charAt(0) : 'A'}
                    </div>
                    <div class="ml-4 flex flex-col justify-center">
                        <span class="font-semibold">{frontmatter.author || 'Auteur Inconnu'}</span>
                    </div>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-4">
                        Sur cette page
                    </h3>
                    
                    {Array.isArray(headings) && headings.length > 0 ? (
                        <nav class="toc">
                            <ul class="space-y-2">
                                {headings.map((heading: { depth: number; slug: string; text: string }) => (
                                    <li 
                                        class={`toc-item toc-depth-${heading.depth}`}
                                        style={`margin-left: ${(heading.depth - 2) * 0.75}rem`}
                                    >
                                        <a 
                                            href={`#${heading.slug}`}
                                            class="text-sm text-gray-600 hover:text-gray-900 transition-colors block py-1"
                                        >
                                            {heading.text}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </nav>
                    ) : (
                        <p class="text-sm text-gray-500">Aucun titre dans cet article</p>
                    )}
                </div>

             </div>
        </aside>
        
        <!-- ↓ AJOUTE prose prose-lg max-w-none ICI -->
        <article class="w-full flex flex-col gap-4 prose prose-lg prose-slate max-w-none md:w-3/4 md:pl-2 lg:w-3/4 lg:pl-2">
            {frontmatter.mainImage && (
                <img 
                    src={frontmatter.mainImage} 
                    alt={frontmatter.title} 
                    class="w-full aspect-video object-cover mb-8 rounded-lg shadow-md not-prose"
                />
            )}
            
            <h1 class="text-h2 mb-4 not-prose">{frontmatter.title}</h1>
            
            {frontmatter.pubDate && (
                <div class="flex items-center gap-3 text-sm text-gray-500 mb-6 not-prose">
                    <span>
                        Publié le {new Date(frontmatter.pubDate).toLocaleDateString('fr-FR', { 
                            year: 'numeric', 
                            month: 'long', 
                            day: 'numeric' 
                        })}
                    </span>
                    {frontmatter.author && (
                        <>
                            <span>•</span>
                            <span>Par {frontmatter.author}</span>
                        </>
                    )}
                </div>
            )}
            
            <slot />
        </article>
    </main>
    
    
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const tocLinks = document.querySelectorAll('.toc a');
        const headings = document.querySelectorAll('article h2, article h3, article h4');
        const tocItems = document.querySelectorAll('.toc .toc-item');
    
        if (tocLinks.length === 0 || headings.length === 0) return;
    
        // Construire la map H2 -> H3 enfants dans la TOC
        function getH2Groups() {
            const groups: Map<HTMLElement, HTMLElement[]> = new Map();
            let currentH2Item: HTMLElement | null = null;
    
            tocItems.forEach((item) => {
                const el = item as HTMLElement;
                if (el.classList.contains('toc-depth-2')) {
                    currentH2Item = el;
                    groups.set(el, []);
                } else if (el.classList.contains('toc-depth-3') && currentH2Item) {
                    groups.get(currentH2Item)!.push(el);
                }
            });
    
            return groups;
        }
    
        const h2Groups = getH2Groups();
    
        // Masquer tous les H3 par défaut
        function collapseAll() {
            h2Groups.forEach((children) => {
                children.forEach((child) => {
                    child.style.maxHeight = '0';
                    child.style.opacity = '0';
                    child.style.overflow = 'hidden';
                    child.style.transition = 'max-height 300ms ease, opacity 200ms ease';
                });
            });
        }
    
        // Déplier les H3 d'un H2
        function expandGroup(h2Item: HTMLElement) {
            const children = h2Groups.get(h2Item);
            if (!children) return;
            children.forEach((child) => {
                child.style.maxHeight = '50px';
                child.style.opacity = '1';
            });
        }
    
        collapseAll();
    
        // Trouver le toc-item H2 parent d'un heading ID
        function findParentH2Item(id: string): HTMLElement | null {
            const link = document.querySelector(`.toc a[href="#${id}"]`);
            if (!link) return null;
            const item = link.closest('.toc-item') as HTMLElement;
            if (!item) return null;
    
            // Si c'est déjà un H2, retourner directement
            if (item.classList.contains('toc-depth-2')) return item;
    
            // Sinon remonter pour trouver le H2 parent
            let prev = item.previousElementSibling as HTMLElement | null;
            while (prev) {
                if (prev.classList.contains('toc-depth-2')) return prev;
                prev = prev.previousElementSibling as HTMLElement | null;
            }
            return null;
        }
    
        let currentActiveH2: HTMLElement | null = null;
    
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const id = entry.target.id;
    
                        // Retirer active de tous les liens
                        tocLinks.forEach(link => link.classList.remove('active'));
    
                        // Activer le lien courant
                        const activeLink = document.querySelector(`.toc a[href="#${id}"]`);
                        if (activeLink) activeLink.classList.add('active');
    
                        // Gérer le repli/dépli des H3
                        const parentH2 = findParentH2Item(id);
                        if (parentH2 && parentH2 !== currentActiveH2) {
                            collapseAll();
                            expandGroup(parentH2);
                            currentActiveH2 = parentH2;
                        }
                    }
                });
            },
            {
                rootMargin: '-100px 0px -66%',
                threshold: 0
            }
        );
    
        headings.forEach(heading => observer.observe(heading));
    });
    </script>

<style is:global>
    .toc a.active {
    border-left-color: #3b82f6;
    color: #1f2937;
    font-weight: 600;
    background-color: rgba(59, 130, 246, 0.08);
    }

    .toc a {
        display: block;
        border-left: 2px solid transparent;
        padding: 0.375rem 0 0.375rem 0.75rem;
        transition: all 200ms ease;
    }
    .blog-post h1,
.blog-post h2,
.blog-post h3,
.blog-post h4,
.blog-post h5,
.blog-post h6 {
  animation: none !important;
}
    /* ============================================
       CONFIGURATION GLOBALE - TYPOGRAPHIE MODERNE
       ============================================ */
    
    .prose {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Inter', sans-serif;
        color: #1f2937;
        line-height: 1.75;
    }

    /* ============================================
       TABLEAUX - STYLE ULTRA-MINIMALISTE
       ============================================ */
    
    .prose table {
        width: 100%;
        border-collapse: collapse;
        margin: 3rem 0;
        font-size: 0.9375rem;
        /* Pas d'ombre - design épuré */
    }

    /* En-tête - Ligne simple du bas uniquement */
    .prose thead {
        border-bottom: 2px solid #e5e7eb;
    }

    .prose th {
        padding: 0.75rem 1rem;
        text-align: left;
        font-weight: 600;
        font-size: 0.8125rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #6b7280;
        border: none; /* Pas de bordures latérales */
    }

    /* Corps du tableau */
    .prose tbody tr {
        border-bottom: 1px solid #f3f4f6;
        transition: background-color 150ms ease;
    }

    .prose tbody tr:last-child {
        border-bottom: none;
    }

    /* Hover très subtil */
    .prose tbody tr:hover {
        background-color: #fafafa;
    }

    .prose td {
        padding: 1rem;
        color: #374151;
        border: none; /* Pas de bordures */
    }

    /* Alignement centré pour la colonne "À obfusquer" */
    .prose th:nth-child(2),
    .prose td:nth-child(2) {
        text-align: center;
    }

    /* ============================================
       TYPOGRAPHIE - TITRES ÉLÉGANTS
       ============================================ */
    
    .prose h2 {
        font-size: 2rem;
        font-weight: 700;
        margin-top: 3rem;
        margin-bottom: 1rem;
        color: #111827;
        letter-spacing: -0.02em;
    }

    .prose h3 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        color: #1f2937;
    }

    .prose h4 {
        font-size: 1.125rem;
        font-weight: 600;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        color: #374151;
    }

    /* ============================================
       PARAGRAPHES & TEXTE
       ============================================ */
    
    .prose p {
        margin-bottom: 1.5rem;
        color: #374151;
        font-size: 1.0625rem;
    }

    .prose strong {
        font-weight: 600;
        color: #111827;
    }

    /* ============================================
       LISTES
       ============================================ */
    
    .prose ul,
    .prose ol {
        margin: 1.5rem 0;
        padding-left: 1.5rem;
    }

    .prose li {
        margin-bottom: 0.5rem;
        color: #374151;
    }

    .prose li::marker {
        color: #9ca3af;
    }

    /* ============================================
       LIENS - Style subtil
       ============================================ */
    
    .prose a {
        color: #3b82f6;
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 200ms ease;
    }

    .prose a:hover {
        border-bottom-color: #3b82f6;
    }

    /* ============================================
       CODE BLOCKS
       ============================================ */
    
    .prose code {
        background-color: #f3f4f6;
        padding: 0.125rem 0.375rem;
        border-radius: 0.25rem;
        font-size: 0.875em;
        color: #be185d;
        font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', monospace;
    }

    .prose pre {
        background-color: #1f2937;
        color: #e5e7eb;
        padding: 1.25rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        margin: 2rem 0;
        font-size: 0.875rem;
        line-height: 1.7;
    }

    .prose pre code {
        background-color: transparent;
        padding: 0;
        color: inherit;
    }

    /* ============================================
       CITATIONS
       ============================================ */
    
    .prose blockquote {
        border-left: 3px solid #e5e7eb;
        padding-left: 1.5rem;
        margin: 2rem 0;
        font-style: italic;
        color: #6b7280;
    }

    /* ============================================
       RESPONSIVE
       ============================================ */
    
    @media (max-width: 768px) {
        .prose table {
            font-size: 0.875rem;
            display: block;
            overflow-x: auto;
            white-space: nowrap;
        }

        .prose th,
        .prose td {
            padding: 0.75rem 0.5rem;
        }

        .prose h2 {
            font-size: 1.5rem;
        }

        .prose p {
            font-size: 1rem;
        }
    }
</style>
